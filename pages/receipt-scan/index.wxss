.block-title {
  margin-bottom: 16rpx;
  font-size: 27rpx;
  font-weight: 650;
  color: #25231f;
}

.hint {
  margin-top: 14rpx;
  color: #8a857c;
  font-size: 22rpx;
  line-height: 1.5;
}

.photo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 280rpx;
  border: 2rpx dashed #d8cfc0;
  border-radius: 14rpx;
  color: #8a857c;
}

.photo-plus {
  font-size: 70rpx;
  line-height: 1;
  color: #b9b1a4;
}

.photo-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.photo-preview {
  position: relative;
}

.photo-img {
  width: 100%;
  height: 320rpx;
  border-radius: 14rpx;
}

.photo-repick {
  margin-top: 14rpx;
  text-align: center;
  color: #2f7058;
  font-size: 24rpx;
}

.paste-area {
  width: 100%;
  min-height: 200rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f8f4ec;
}

.block {
  width: 100%;
  margin-top: 16rpx;
}

/* 候选行 */
.cand {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1eadf;
}

.cand-check {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc3b4;
  background: #ffffff;
}

.cand-check.on {
  background: #2f7058;
  border-color: #2f7058;
}

.cand-body {
  flex: 1;
  min-width: 0;
}

.cand-name {
  width: 100%;
  height: 70rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #f8f4ec;
}

.cand-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.cand-qty {
  width: 110rpx;
  height: 64rpx;
  padding: 0 12rpx;
  text-align: center;
  border-radius: 10rpx;
  background: #f8f4ec;
}

.cand-unit {
  width: 110rpx;
  height: 64rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: #f8f4ec;
}

.cat-picker {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  line-height: 64rpx;
  border-radius: 10rpx;
  background: #f8f4ec;
  color: #443f38;
  font-size: 24rpx;
}

.cand-del {
  flex: 0 0 auto;
  width: 56rpx;
  text-align: center;
  color: #b94732;
  font-size: 40rpx;
  line-height: 64rpx;
}

.save {
  margin-top: 20rpx;
}

.recipe-main {
  flex: 1;
  min-width: 0;
}

/* 分类 tab */
.cat-tabs {
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.cat-tab {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin-right: 14rpx;
  background: #ffffff;
  border: 1rpx solid #ece4d7;
  border-radius: 999rpx;
  color: #6c6a64;
  font-size: 26rpx;
}

.cat-on {
  background: #2f7058;
  border-color: #2f7058;
  color: #ffffff;
}

/* 分组标题 */
.group-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 26rpx 4rpx 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #443f38;
}

.group-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #f1eee7;
  color: #8a857c;
  font-size: 21rpx;
  font-weight: 600;
}

.ings {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.ing-chip {
  display: inline-flex;
  align-items: center;
  margin: 0 10rpx 10rpx 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f5f3;
  color: #4a6a5e;
  font-size: 22rpx;
}

.note {
  margin-top: 14rpx;
  color: #555149;
  font-size: 25rpx;
}

.arrow {
  color: #aaa298;
  font-size: 50rpx;
}

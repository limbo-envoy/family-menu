/* 快捷操作 */
.action-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
}

.action-btn::after {
  border: 0;
}

.action-primary {
  background: #2f7058;
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(47, 112, 88, 0.18);
}

.action-secondary {
  background: #ffffff;
  color: #2f7058;
  border: 1rpx solid #d7e3dc;
}

.action-icon {
  font-size: 34rpx;
}

/* 临期 / 过期提醒 */
.reminder-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.reminder-expired {
  background: #fff2ee;
  color: #943b2b;
}

.reminder-soon {
  background: #fdf5e6;
  color: #8a5a1e;
}

.reminder-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex: 0 0 auto;
}

.reminder-dot-expired {
  background: #e6523a;
}

.reminder-dot-soon {
  background: #f5a623;
}

.reminder-count {
  font-weight: 700;
}

.reminder-text {
  line-height: 1.4;
}

/* 筛选与排序卡片 */
.filter-card {
  margin-bottom: 20rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #eee5d8;
}

.chips {
  white-space: nowrap;
}

.chip {
  display: inline-block;
  margin-right: 14rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #f6f4ef;
  color: #5e5a52;
  font-size: 25rpx;
}

.chip:last-child {
  margin-right: 0;
}

.chip-on {
  background: #2f7058;
  color: #ffffff;
  font-weight: 600;
}

.sort-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0ebe3;
}

.sort-label {
  margin-right: 18rpx;
  color: #8a857c;
  font-size: 24rpx;
}

.seg {
  display: flex;
  background: #f6f4ef;
  border-radius: 999rpx;
  overflow: hidden;
}

.seg-item {
  padding: 10rpx 24rpx;
  font-size: 23rpx;
  color: #6c6a64;
}

.seg-item.on {
  background: #2f7058;
  color: #ffffff;
  font-weight: 600;
}

/* 列表项 */
.item {
  padding-right: 16rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.qty {
  margin-left: 12rpx;
  font-weight: 600;
  color: #443f38;
}

.meta.sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a857c;
}

.meta.sub .dot {
  margin: 0 10rpx;
}

.status {
  margin-right: 14rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  flex: 0 0 auto;
}

.status-expired {
  background: #fdecea;
  color: #b94732;
}

.status-soon {
  background: #fdf3e2;
  color: #b9772a;
}

.status-none {
  background: #eef1f4;
  color: #6c6a64;
}

.arrow {
  color: #aaa298;
  font-size: 50rpx;
  flex: 0 0 auto;
}

.empty {
  margin-top: 120rpx;
  color: #77736a;
  text-align: center;
}

/* 批量管理按钮 */
.action-manage {
  background: #f6f4ef;
  color: #6c6a64;
  border: 1rpx solid #e3ded4;
}

.action-manage.on {
  background: #fdecea;
  color: #c0392b;
  border-color: #f3c6bf;
}

/* 进入管理模式的列表项 */
.item-edit {
  padding-left: 12rpx;
}

.item-selected {
  background: #eef7f2;
  border: 1rpx solid #b9dccb;
}

/* 复选框 */
.check {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  border: 2rpx solid #c7c1b6;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #ffffff;
}

.check-on {
  background: #2f7058;
  border-color: #2f7058;
}

/* 底部批量操作栏 */
.batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #ece7df;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.06);
}

.batch-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 28rpx;
  color: #443f38;
}

.batch-del {
  flex: 0 0 auto;
  height: 80rpx;
  margin: 0;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: #e34d59;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.batch-del::after {
  border: 0;
}

.batch-del[disabled] {
  background: #e9cfd2;
  color: #ffffff;
}

/* 给底部操作栏留出空间 */
.page.has-batch {
  padding-bottom: 150rpx;
}

<view class="page form-page">
  <view class="field">
    <view class="label">菜名</view>
    <input class="field-input" placeholder="比如 番茄炒蛋" value="{{form.name}}" data-field="name" bindinput="onInput" />
  </view>

  <view class="field">
    <view class="label">分类</view>
    <input class="field-input" placeholder="家常菜、凉菜、汤、主食..." value="{{form.category}}" data-field="category" bindinput="onInput" />
  </view>

  <view class="field">
    <view class="label">食材（每行一份，会用于检查库存和自动扣减）</view>
    <view class="ing-row head">
      <text class="ing-name">食材名</text>
      <text class="ing-qty">用量</text>
      <text class="ing-unit">单位</text>
      <text class="ing-del"></text>
    </view>
    <view class="ing-row" wx:for="{{ingredients}}" wx:key="index">
      <input class="ing-name" placeholder="番茄" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onIngredientInput" />
      <input class="ing-qty" type="digit" placeholder="2" value="{{item.qty}}" data-index="{{index}}" data-field="qty" bindinput="onIngredientInput" />
      <input class="ing-unit" placeholder="个" value="{{item.unit}}" data-index="{{index}}" data-field="unit" bindinput="onIngredientInput" />
      <view class="ing-del" data-index="{{index}}" bindtap="removeIngredient">×</view>
    </view>
    <button class="ghost-btn add-ing" bindtap="addIngredient">+ 添加食材</button>
  </view>

  <view class="field">
    <view class="label">步骤</view>
    <textarea class="field-area large" placeholder="写简单一点，自己看得懂就行" value="{{form.steps}}" data-field="steps" bindinput="onInput" />
  </view>

  <view class="field">
    <view class="label">备注</view>
    <textarea class="field-area" placeholder="口味、火候、家里谁爱吃..." value="{{form.note}}" data-field="note" bindinput="onInput" />
  </view>

  <view class="actions">
    <button class="primary-btn save" bindtap="saveRecipe">保存菜谱</button>
    <button class="danger-btn" wx:if="{{form.id}}" bindtap="confirmRemove">删除</button>
  </view>
</view>

.form-page {
  padding-bottom: 54rpx;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #555149;
  font-size: 25rpx;
  font-weight: 600;
}

.field-input,
.field-area {
  width: 100%;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #eee5d8;
}

.field-input {
  height: 82rpx;
}

.field-area {
  min-height: 150rpx;
}

.field-area.large {
  min-height: 230rpx;
}

/* 结构化食材行 */
.ing-row {
  display: grid;
  grid-template-columns: 1fr 90rpx 90rpx 56rpx;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.ing-row.head {
  color: #8a857c;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.ing-name,
.ing-qty,
.ing-unit {
  height: 76rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid #eee5d8;
  min-width: 0;
}

.ing-del {
  text-align: center;
  color: #b94732;
  font-size: 40rpx;
  line-height: 76rpx;
}

.add-ing {
  margin-top: 6rpx;
}

.actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin-top: 34rpx;
}

.save {
  width: 100%;
}

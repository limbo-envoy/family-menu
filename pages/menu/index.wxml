<view class="page">
  <view class="topbar">
    <view>
      <view class="title">今天吃什么</view>
      <view class="subtitle">选菜谱或自己配食材，自动扣库存、自动记账</view>
    </view>
    <button class="ghost-btn" bindtap="goInventory">库存</button>
  </view>

  <!-- 模式切换 -->
  <view class="segment">
    <view class="seg-item {{mode === 'recipe' ? 'seg-on' : ''}}" data-mode="recipe" bindtap="switchMode">选菜谱</view>
    <view class="seg-item {{mode === 'custom' ? 'seg-on' : ''}}" data-mode="custom" bindtap="switchMode">配食材</view>
  </view>

  <!-- 选菜谱模式 -->
  <block wx:if="{{mode === 'recipe'}}">
    <!-- 根据库存推荐 -->
    <view class="card reco" wx:if="{{recommended.length}}">
      <view class="reco-title">🍳 根据库存，今天能做的菜</view>
      <scroll-view class="reco-scroll" scroll-x="true">
        <view class="reco-item" wx:for="{{recommended}}" wx:key="id" data-id="{{item.id}}" bindtap="addRecipeDish">
          <view class="reco-name">{{item.name}}</view>
          <view class="reco-pill {{item.enough ? 'ok' : 'part'}}">{{item.enough ? '食材齐全' : '差 ' + (item.total - item.available) + ' 样'}}</view>
        </view>
      </scroll-view>
      <view class="reco-hint">点一下直接加入本餐</view>
    </view>

    <input class="search" placeholder="搜索菜名、分类" value="{{keyword}}" bindinput="onSearch" />

    <scroll-view class="cat-tabs" scroll-x="true">
      <view class="cat-tab {{activeCategory === item ? 'cat-on' : ''}}" wx:for="{{categories}}" wx:key="*this" data-cat="{{item}}" bindtap="setCategory">{{item}}</view>
    </scroll-view>

    <view class="hint">点击菜名展开食材清单</view>
    <view class="card recipe-card" wx:for="{{filteredRecipes}}" wx:key="id">
      <view class="row">
        <view class="recipe-main" data-id="{{item.id}}" bindtap="toggleRecipe">
          <view class="name">{{item.name}}</view>
          <view class="meta">
            <text class="tag">{{item.category || '未分类'}}</text>
            <text class="badge {{item.enough ? 'badge-ok' : 'badge-short'}}">
              {{item.enough ? '食材充足' : '缺 ' + item.missingCount + ' 种'}}
            </text>
            <text class="chevron {{expandedId === item.id ? 'chevron-on' : ''}}">▾</text>
          </view>
        </view>
        <button class="round-add" data-id="{{item.id}}" catchtap="addRecipeDish">加入</button>
      </view>
      <view class="ing-panel" wx:if="{{expandedId === item.id}}">
        <view class="ing-row" wx:for="{{item.ingredientLines}}" wx:for-item="ing" wx:key="name">
          <text class="ing-name">{{ing.name}}</text>
          <text class="ing-qty">{{ing.qty}}{{ing.unit}}</text>
          <text class="ing-stock {{ing.sufficient ? 'ok' : 'short'}}">{{ing.sufficient ? '有货' : '缺货'}}</text>
        </view>
        <view class="ing-steps" wx:if="{{item.steps}}">做法：{{item.steps}}</view>
        <view class="ing-note" wx:if="{{item.note}}">备注：{{item.note}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!filteredRecipes.length}}">没找到菜。去菜谱库添加一道吧。</view>
  </block>

  <!-- 配食材模式 -->
  <block wx:else>
    <view class="card">
      <input class="dish-name" placeholder="给这道自制菜起个名（可留空）" value="{{customName}}" bindinput="onCustomName" />
    </view>
    <view class="card ing-line" wx:for="{{customIngredients}}" wx:key="id">
      <view class="ing-info">
        <view class="name">{{item.name}}</view>
        <view class="meta">剩 {{item.remaining}} {{item.unit}}</view>
      </view>
      <view class="stepper">
        <view class="step-btn" data-id="{{item.id}}" data-delta="{{-1}}" bindtap="stepCustom">-</view>
        <text class="step-num">{{item.useQty}}</text>
        <view class="step-btn" data-id="{{item.id}}" data-delta="{{1}}" bindtap="stepCustom">+</view>
      </view>
    </view>
    <button class="primary-btn block" bindtap="addCustomDish">把这几种食材加入本餐</button>
    <view class="empty" wx:if="{{!customIngredients.length}}">库存还是空的，先去录入食材。</view>
  </block>

  <!-- 本餐清单 -->
  <view class="cart card" wx:if="{{planned.length}}">
    <view class="row">
      <view>
        <view class="name">本餐 {{planned.length}} 道菜</view>
        <view class="meta">确认后扣减库存并记录</view>
      </view>
    </view>
    <view class="cart-line" wx:for="{{planned}}" wx:key="key">
      <text>{{item.name}}<text class="dish-type">{{item.type === 'recipe' ? '（菜谱）' : '（自制）'}}</text></text>
      <text class="remove" data-key="{{item.key}}" bindtap="removeDish">移除</text>
    </view>
    <input class="note-input" placeholder="备注，比如谁来吃、口味要求" value="{{note}}" bindinput="onNote" />
    <button class="primary-btn block cook" bindtap="openConfirm">确认开做</button>
  </view>

  <!-- 确认开做弹层 -->
  <view class="mask" wx:if="{{confirm.open}}" bindtap="closeConfirm">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">确认食材用量</view>
      <view class="sheet-sub" wx:if="{{confirm.hasShortage}}">
        有 {{confirm.totalShort}} 种食材不足，缺的部分可手动调整本次用量，或直接确认（缺口会记到账上待采购）。
      </view>
      <view class="sheet-sub" wx:else>食材都够，确认后自动扣减并记账。</view>

      <scroll-view class="sheet-list" scroll-y>
        <view class="conf-line" wx:for="{{confirm.lines}}" wx:key="name" wx:for-index="idx">
          <view class="conf-head">
            <text class="name">{{item.name}}</text>
            <text class="conf-avail">库存 {{item.available}}{{item.unit}} / 需 {{item.required}}{{item.unit}}</text>
          </view>
          <view class="conf-row">
            <text class="conf-label">本次用量</text>
            <input class="conf-input" type="digit" value="{{item.consume}}" data-index="{{idx}}" bindinput="onConsumeInput" />
            <text class="conf-unit">{{item.unit}}</text>
            <text class="conf-short" wx:if="{{item.shortage > 0}}">缺口 {{item.shortage}}{{item.unit}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="sheet-actions">
        <button class="ghost-btn" bindtap="closeConfirm">再看看</button>
        <button class="primary-btn" bindtap="confirmCook">确认扣减并记账</button>
      </view>
    </view>
  </view>
</view>

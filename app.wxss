page {
  background: #f8f4ec;
  color: #25231f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
input,
textarea,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.4;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 8rpx;
  color: #737067;
  font-size: 25rpx;
}

.primary-btn {
  min-width: 156rpx;
  padding: 16rpx 22rpx;
  background: #2f7058;
  color: #ffffff;
}

.ghost-btn {
  padding: 14rpx 20rpx;
  background: #ffffff;
  color: #2f7058;
  border: 1rpx solid #d7e3dc;
}

.danger-btn {
  padding: 12rpx 18rpx;
  background: #fff2ee;
  color: #b94732;
}

.search {
  width: 100%;
  height: 78rpx;
  margin-bottom: 22rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #ece4d7;
}

.card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #eee5d8;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.name {
  font-size: 31rpx;
  font-weight: 650;
}

.meta {
  margin-top: 8rpx;
  color: #77736a;
  font-size: 24rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  margin-right: 10rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #edf6f1;
  color: #2f7058;
  font-size: 22rpx;
}

.empty {
  margin-top: 120rpx;
  color: #77736a;
  text-align: center;
}
